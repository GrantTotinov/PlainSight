{
  "name": "plainsight",
  "description": "Remove AI Overviews and AI Mode from Google Search.",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "pnpm build:chrome && pnpm build:edge && pnpm build:firefox",
    "build:chrome": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip && wxt zip -b edge && wxt zip -b firefox --mv3",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "domains:update": "node scripts/update-google-domains.ts",
    "fixtures:capture": "node scripts/capture-fixtures.ts",
    "store:assets": "node scripts/store-assets.ts",
    "postinstall": "wxt prepare",
    "e2e": "node scripts/e2e.ts"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.0",
    "prettier": "^3.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "packageManager": "pnpm@12.14.0"
}
